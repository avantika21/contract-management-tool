aws_region  = "eu-west-2" # London - fixed for data residency
environment = "dev"

# Bedrock model IDs available in eu-west-2. Check current availability with:
#   aws bedrock list-foundation-models --region eu-west-2
bedrock_extraction_model_id = "eu.anthropic.claude-sonnet-4-5-20250929-v1:0"
bedrock_embedding_model_id  = "amazon.titan-embed-text-v2:0"
embedding_dimensions        = 1024

alert_email = "procurement-alerts@example.com"
